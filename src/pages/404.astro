---
import Base from '../layouts/Base.astro';
import { getSettings } from '../lib/content';
import { t } from '../lib/i18n';
const s = await getSettings();
const tr = t(s.lang);
---
<Base title={tr.notFoundTitle} description={tr.notFoundDesc} path="/404/" seo={{ noindex: true }}>
  <section class="section notfound">
    <div class="container container--narrow">
      <p class="notfound__code">404</p>
      <h1 class="section__title">{tr.notFoundTitle}</h1>
      <p>{tr.notFoundText}</p>
      <a class="btn btn--primary" href="/">{tr.notFoundBack}</a>
    </div>
  </section>
</Base>
