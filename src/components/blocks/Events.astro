---
import { getCollectionItems, getSettings } from '../../lib/content';
import { formatDate } from '../../lib/text';
import { t } from '../../lib/i18n';
const s = await getSettings();
const { title } = Astro.props;
const lang = Astro.props.lang ?? s.lang;
const items = await getCollectionItems('events', { lang });
---
{items.length > 0 && (
  <section class="section events reveal">
    <div class="container">
      {title && <h2 class="section__title">{title}</h2>}
      <div class="list-cards">
        {items.map((e) => (
          <article class="card">
            <p class="card__meta">{formatDate(e.startDate, lang)}{e.location ? ` · ${e.location}` : ''}</p>
            <h3 class="card__title">{e.title}</h3>
            {e.description && <p class="card__text">{e.description}</p>}
            {e.url && <a class="card__link" href={e.url}>{t(lang).details}</a>}
          </article>
        ))}
      </div>
    </div>
  </section>
)}
