---
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-700.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '../styles/global.css';
import { getPages, getSettings } from '../lib/content';
import type { Seo } from '../lib/content';
import { localePrefix, localizedSettings, siteLocales, t } from '../lib/i18n';
import Head from '../components/seo/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tracking from '../components/Tracking.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string; description?: string; path: string; seo?: Seo;
  type?: 'website' | 'article'; ogImage?: string; jsonLd?: Record<string, unknown>[];
  /** Lingua della pagina (default: principale) e sue traduzioni (per hreflang e selettore lingua). */
  lang?: string; alternates?: { lang: string; path: string }[];
}
const props = Astro.props;
const base = await getSettings();
const lang = props.lang ?? base.lang;
const settings = localizedSettings(base, lang);
const pages = await getPages(lang);
const tr = t(lang);
const alternates = props.alternates ?? [];
// Selettore lingua: per ogni lingua la traduzione di questa pagina, altrimenti la home di quella lingua.
const locales = siteLocales(base);
const switcher = locales.length > 1
  ? locales.map((l) => ({ lang: l, path: alternates.find((a) => a.lang === l)?.path ?? `${localePrefix(base, l)}/`, current: l === lang }))
  : [];

// Editor mockup: SOLO build di staging E con password impostata (mai default). In produzione
// non esiste né lo script né la password nell'HTML.
const stage = import.meta.env.PUBLIC_STAGE;
const editorPassword = stage === 'staging' ? process.env.EDITOR_PASSWORD : undefined;
if (stage === 'staging' && !editorPassword) console.warn('[editor] EDITOR_PASSWORD non impostata: editor mockup non incluso.');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <Tracking settings={settings} />
    <Head settings={settings} {...props} lang={lang} alternates={locales.length > 1 ? alternates : []} />
  </head>
  <body>
    <a class="skip-link" href="#main">{tr.skipLink}</a>
    <Header settings={settings} pages={pages} lang={lang} switcher={switcher} />
    <main id="main"><slot /></main>
    <Footer settings={settings} pages={pages} lang={lang} />
    <CookieBanner settings={settings} lang={lang} />
    <script>import '../scripts/site.js';</script>
    {editorPassword && <script is:inline set:html={`window.AUT_STAGE='staging';window.AUT_EDITOR_PASSWORD=${JSON.stringify(editorPassword)};`}></script>}
    {editorPassword && <script is:inline src="/assets/js/editor.js" defer></script>}
  </body>
</html>
