# Variabili di BUILD (mai committare il file .env). Aggiorna questo file a ogni nuova variabile.

# staging | production (default: production). Lo imposta il workflow: production solo su `main`.
PUBLIC_STAGE=production

# Password dell'editor mockup. Letta SOLO nelle build di staging; senza di lei l'editor non viene incluso.
EDITOR_PASSWORD=

# Sposta i contenuti (default ./src/content). Usato dall'esempio: examples/local-business/content
CONTENT_DIR=./src/content

# fs = adattatore di test dell'interfaccia dati (non usare in produzione)
CONTENT_ADAPTER=

# 1 = la build fallisce se restano placeholder {{...}} o asset brand non generati (usare su main)
STRICT=0

# Cartella di output (default ./dist)
OUT_DIR=./dist
