---
/** Pagina privacy/cookie in una lingua (usata da /privacy/ e /<lingua>/privacy/). */
import Base from '../../layouts/Base.astro';
import { getSettings } from '../../lib/content';
import { privacyPath, siteLocales, t } from '../../lib/i18n';
const { lang } = Astro.props as { lang: string };
const s = await getSettings();
const tr = t(lang);
const tk = s.tracking;
const iub = tk.iubendaCookiePolicyId && tk.iubendaSiteId;
const l = s.legal;
const alternates = siteLocales(s).map((x) => ({ lang: x, path: privacyPath(s, x) }));
---
<Base title={tr.privacyTitle} description={`${tr.privacyDesc} ${s.name}`} path={privacyPath(s, lang)} lang={lang} alternates={alternates}>
  <section class="section">
    <div class="container container--narrow">
      <h1 class="section__title">{tr.privacyTitle}</h1>
      {iub ? (
        <>
          <p>{tr.privacyIubenda}</p>
          <ul>
            <li><a href={`https://www.iubenda.com/privacy-policy/${tk.iubendaCookiePolicyId}`} rel="noopener">Privacy Policy</a></li>
            <li><a href={`https://www.iubenda.com/privacy-policy/${tk.iubendaCookiePolicyId}/cookie-policy`} rel="noopener">Cookie Policy</a></li>
          </ul>
        </>
      ) : (
        <>
          <p>{tr.privacyTechnical}</p>
          <p>{tr.privacyController}: {l.companyName ?? s.name}{l.vatId ? `, ${tr.vat} ${l.vatId}` : ''}{l.address ? `, ${l.address}` : ''}{s.contact.email ? <> — <a href={`mailto:${s.contact.email}`}>{s.contact.email}</a></> : ''}.</p>
          <p><em>{tr.privacyPlaceholder}</em></p>
        </>
      )}
    </div>
  </section>
</Base>
