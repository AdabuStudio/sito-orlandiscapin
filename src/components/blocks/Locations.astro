---
import { getCollectionItems } from '../../lib/content';
import { t } from '../../lib/i18n';
const { title, lang } = Astro.props;
const items = await getCollectionItems('locations', { lang });
---
{items.length > 0 && (
  <section class="section locations reveal">
    <div class="container">
      {title && <h2 class="section__title">{title}</h2>}
      <div class="list-cards">
        {items.map((l) => (
          <article class="card">
            <h3 class="card__title">{l.name}</h3>
            <p class="card__meta">{l.address.street}, {l.address.postalCode} {l.address.city}</p>
            {l.phone && <p class="card__text"><a href={`tel:${l.phone.replace(/\s/g, '')}`}>{l.phone}</a></p>}
            {l.openingHours.length > 0 && <p class="card__text">{l.openingHours.join(' · ')}</p>}
            {l.geo && <a class="card__link" href={`https://www.openstreetmap.org/?mlat=${l.geo.lat}&mlon=${l.geo.lng}#map=17/${l.geo.lat}/${l.geo.lng}`} rel="noopener">{t(lang).directions}</a>}
          </article>
        ))}
      </div>
    </div>
  </section>
)}
