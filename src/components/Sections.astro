---
import type { Section } from '../lib/content';
import Hero from './blocks/Hero.astro'; import Text from './blocks/Text.astro'; import FeatureGrid from './blocks/FeatureGrid.astro';
import Gallery from './blocks/Gallery.astro'; import Cta from './blocks/Cta.astro'; import Logos from './blocks/Logos.astro';
import Faq from './blocks/Faq.astro'; import Steps from './blocks/Steps.astro'; import Contact from './blocks/Contact.astro';
import StatBand from './blocks/StatBand.astro'; import Timeline from './blocks/Timeline.astro'; import Split from './blocks/Split.astro';
import Map from './blocks/Map.astro'; import Locations from './blocks/Locations.astro'; import Services from './blocks/Services.astro';
import Events from './blocks/Events.astro'; import Notices from './blocks/Notices.astro'; import PostList from './blocks/PostList.astro';
import ContactForm from './blocks/ContactForm.astro';

const blocks: Record<Section['type'], any> = {
  hero: Hero, text: Text, 'feature-grid': FeatureGrid, gallery: Gallery, cta: Cta, logos: Logos, faq: Faq, steps: Steps,
  contact: Contact, 'stat-band': StatBand, timeline: Timeline, split: Split, map: Map, locations: Locations,
  services: Services, events: Events, notices: Notices, 'post-list': PostList, 'contact-form': ContactForm,
};
/** `lang` arriva a ogni blocco: serve a filtrare le collezioni e a scegliere i testi dell'interfaccia. */
const { sections, lang } = Astro.props as { sections: Section[]; lang: string };
---
{sections.map((s) => { const Block = blocks[s.type]; return <Block {...s} lang={lang} />; })}
