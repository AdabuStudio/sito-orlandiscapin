---
import { getSettings } from '../../lib/content';
import { t } from '../../lib/i18n';
const s = await getSettings();
const { title, text } = Astro.props;
const tr = t(Astro.props.lang ?? s.lang);
const email = Astro.props.email ?? s.contact.email;
const phone = Astro.props.phone ?? s.contact.phone;
const a = s.contact.address;
const address = Astro.props.address ?? (a ? `${a.street}, ${a.postalCode} ${a.city}` : undefined);
---
<section class="section contact reveal">
  <div class="container container--narrow">
    {title && <h2 class="section__title">{title}</h2>}
    {text && <p class="contact__text">{text}</p>}
    <ul class="contact__list">
      {email && <li><span class="contact__label">{tr.contactEmail}</span> <a href={`mailto:${email}`}>{email}</a></li>}
      {phone && <li><span class="contact__label">{tr.contactPhone}</span> <a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a></li>}
      {address && <li><span class="contact__label">{tr.contactWhere}</span> {address}</li>}
    </ul>
  </div>
</section>
