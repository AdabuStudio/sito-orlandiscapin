---
/**
 * Immagine ottimizzata. `src` può essere:
 *  - un NOME file in src/assets/images/ → astro:assets (webp, srcset, dimensioni);
 *  - un path root-relative (/assets/img/…) o un URL → <img> semplice.
 */
import { Image } from 'astro:assets';
import { findImage, isUrlLike } from '../lib/images';

interface Props { src: string; alt?: string; widths?: number[]; sizes?: string; loading?: 'eager' | 'lazy'; class?: string }
const { src, alt = '', widths = [480, 800, 1200], sizes = '(min-width: 1120px) 1120px, 100vw', loading = 'lazy', class: cls } = Astro.props;

const meta = findImage(src);
const plainSrc = isUrlLike(src) ? src : `/assets/img/${src}`;
if (!meta && !isUrlLike(src)) console.warn(`[Img] "${src}" non trovata in src/assets/images/: uso ${plainSrc}`);
---
{meta
  ? <Image src={meta} alt={alt} widths={widths} sizes={sizes} format="webp" loading={loading} class={cls} />
  : <img src={plainSrc} alt={alt} loading={loading} class={cls} />}
